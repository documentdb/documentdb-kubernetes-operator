{
  "metadata": {
    "name": "golden",
    "namespace": "golden-ns",
    "ownerReferences": [
      {
        "apiVersion": "documentdb.io/v1",
        "kind": "DocumentDB",
        "name": "golden",
        "uid": "00000000-0000-0000-0000-000000000001",
        "controller": true,
        "blockOwnerDeletion": true
      }
    ]
  },
  "spec": {
    "inheritedMetadata": {
      "labels": {
        "app": "golden",
        "replica_type": "primary"
      }
    },
    "instances": 1,
    "postgresql": {
      "parameters": {
        "autovacuum_analyze_scale_factor": "0.05",
        "autovacuum_max_workers": "4",
        "autovacuum_vacuum_cost_delay": "2ms",
        "autovacuum_vacuum_scale_factor": "0.1",
        "checkpoint_completion_target": "0.9",
        "cron.database_name": "postgres",
        "effective_cache_size": "512MB",
        "effective_io_concurrency": "200",
        "maintenance_work_mem": "128MB",
        "max_connections": "300",
        "max_prepared_transactions": "100",
        "max_replication_slots": "10",
        "max_wal_senders": "10",
        "max_wal_size": "2GB",
        "min_wal_size": "256MB",
        "random_page_cost": "1.1",
        "shared_buffers": "256MB",
        "wal_buffers": "16MB",
        "work_mem": "16MB"
      },
      "pg_hba": [
        "host all all localhost trust",
        "hostssl replication streaming_replica all cert"
      ],
      "syncReplicaElectionConstraint": {
        "enabled": false
      },
      "shared_preload_libraries": [
        "pg_cron",
        "pg_documentdb_core",
        "pg_documentdb"
      ],
      "extensions": [
        {
          "name": "documentdb",
          "image": {
            "reference": "ghcr.io/documentdb/documentdb-kubernetes-operator/documentdb:1.0.0"
          },
          "extension_control_path": [
            "share"
          ],
          "dynamic_library_path": [
            "lib"
          ],
          "ld_library_path": [
            "lib",
            "system"
          ]
        }
      ]
    },
    "bootstrap": {
      "recovery": {
        "backup": {
          "name": "bk"
        }
      }
    },
    "storage": {
      "size": "10Gi"
    },
    "stopDelay": 30,
    "affinity": {},
    "resources": {},
    "primaryUpdateMethod": "switchover",
    "backup": {
      "volumeSnapshot": {
        "snapshotOwnerReference": "backup",
        "onlineConfiguration": {}
      },
      "target": "primary"
    },
    "logLevel": "info",
    "managed": {
      "roles": [
        {
          "name": "otel_monitor",
          "ensure": "absent",
          "connectionLimit": -1,
          "inherit": true
        }
      ]
    },
    "plugins": [
      {
        "name": "cnpg-i-sidecar-injector.documentdb.io",
        "enabled": true,
        "parameters": {
          "documentDbCredentialSecret": "documentdb-credentials",
          "gatewayImage": "ghcr.io/documentdb/documentdb-kubernetes-operator/gateway:1.0.0"
        }
      }
    ]
  },
  "status": {
    "managedRolesStatus": {},
    "topology": {},
    "secretsResourceVersion": {},
    "configMapResourceVersion": {},
    "certificates": {},
    "switchReplicaClusterStatus": {}
  }
}
